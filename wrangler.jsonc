// Cloudflare Workers deploy settings. The build (nitro) merges this into the
// generated dist/server/wrangler.json that `npx wrangler deploy` uses.
// "name" must match the Worker name in the Cloudflare dashboard.
// Keys and secrets are NOT stored here: add them in the dashboard under
// Settings → Variables and Secrets (they survive deploys via keep_vars).
{
  "name": "loopgram-sound-sanctuary",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  // Native D1 binding: likes/views use env.DB (no API rate limit).
  "d1_databases": [{ "binding": "DB", "database_name": "loopgramchannel-d1", "database_id": "5e4bdfaf-6eac-4e46-acee-ea72f2ef714c" }],
  "observability": { "enabled": true }
}
